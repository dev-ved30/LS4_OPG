#!/usr/bin/env python

"""Run an LS4 observing simulation."""

import os.path
import argparse
import astropy.units as u
from ztf_sim.simulate import simulate


def _resolve_input_path(path_arg, fallback_dir=None):
        """Resolve a file path from CLI input."""
        if os.path.isfile(path_arg):
                return os.path.abspath(path_arg)
        if fallback_dir is not None and (not os.path.isabs(path_arg)):
                candidate = os.path.join(fallback_dir, path_arg)
                if os.path.isfile(candidate):
                        return os.path.abspath(candidate)
        return None


parser = argparse.ArgumentParser(description="Simulate LS4 observing.")
parser.add_argument('schedule_configuration',
        help="Path to schedule configuration file")
parser.add_argument('simulation_configuration',
        help="Path to simulation configuration file")
parser.add_argument('-o', '--output', default='.',
        help="Directory to write simulation to.")
parser.add_argument('-t', '--time-limit', default=30., type=float,
        help="Number of seconds to allow Gurobi optimizer to run")

args = parser.parse_args()

schedule_fullpath = _resolve_input_path(args.schedule_configuration, 'sims')
if schedule_fullpath is None:
        parser.error(f"schedule configuration not found: {args.schedule_configuration}")
schedule_config_path, schedule_config_file = os.path.split(schedule_fullpath)

sim_fullpath = _resolve_input_path(args.simulation_configuration, 'config')
if sim_fullpath is None:
        parser.error(f"simulation configuration not found: {args.simulation_configuration}")
sim_config_path, sim_config_file = os.path.split(sim_fullpath)

if not os.path.isdir(args.output):
        parser.error(f"output directory not found: {args.output}")

simulate(schedule_config_file, sim_config_file,
    scheduler_config_path=schedule_config_path,
    sim_config_path=sim_config_path,
    output_path=args.output,
    time_limit=args.time_limit * u.second)
